# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/

# --- Generated data (regenerable via generate_all.py, not meant to live in git) ---
data/generated/clean/*.csv
data/generated/raw/*.csv
data/generated/incremental/**/*.csv

# --- Jupyter ---
.ipynb_checkpoints/

# --- Environment / secrets ---
# Bare ".env" (no slash) matches a file of that name at ANY depth in the
# repo -- this already covers ml/.env, src/data_generation/incremental/.env,
# and any future one. The explicit entries below are kept anyway, purely
# as documentation of which real credential files exist in this project.
.env
.env.*
*.pem
*.key
ml/.env
src/data_generation/.env
src/data_generation/incremental/.env
streamlit_app/.streamlit/secrets.toml
models/*.joblib

# --- AWS: never commit a filled-in trust policy (contains your account ID / role ARN) ---
infra/aws/trust_policy_final.json

# --- dbt (Phase 3) ---
target/
dbt_packages/
logs/
.dbt/

# --- Airflow (Phase 7) ---
airflow/logs/
airflow/airflow.db
airflow/airflow.cfg
airflow/webserver_config.py
airflow/.env
airflow/dbt_profiles/profiles.yml

